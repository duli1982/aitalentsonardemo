# Server-side Gemini API key used by the AI gateway.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional server-side model fallback chain.
GEMINI_TEXT_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash

# Optional: disable AI and use the application's deterministic local behavior.
VITE_DISABLE_AI=false

# Optional Google Drive integration.
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Optional governed WhatsApp delivery. Configure either provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_PUBLIC_URL=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Optional verified delivery-event sink used after webhook signature validation.
COMMUNICATION_EVENT_SINK_URL=
COMMUNICATION_EVENT_SINK_TOKEN=

# Optional calendar connectors. Use short-lived, server-managed OAuth tokens.
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
OUTLOOK_CALENDAR_ACCESS_TOKEN=

# Optional Talent Attraction publishing adapters.
GREENHOUSE_PUBLISH_WEBHOOK_URL=
GREENHOUSE_PUBLISH_WEBHOOK_TOKEN=
LEVER_PUBLISH_WEBHOOK_URL=
LEVER_PUBLISH_WEBHOOK_TOKEN=
FACEBOOK_PUBLISH_WEBHOOK_URL=
FACEBOOK_PUBLISH_WEBHOOK_TOKEN=

# Durable Candidate Conversation & Assessment Platform.
# JSON records are written server-side to this directory; use a persistent mounted volume in production.
TALENT_SONAR_DATA_DIR=.talent-sonar-data
TALENT_SONAR_WORKER_ORGANIZATIONS=local-workspace

# Multilingual assessment provider adapter and signed result callback.
LANGUAGE_ASSESSMENT_PROVIDER_URL=
LANGUAGE_ASSESSMENT_PROVIDER_TOKEN=
LANGUAGE_ASSESSMENT_CALLBACK_URL=
CONVERSATION_WEBHOOK_TOKEN=

# Twilio Voice phone screening. TWIML service receives organizationId and phoneSessionId query parameters.
TWILIO_VOICE_FROM=
TWILIO_VOICE_TWIML_URL=
TWILIO_VOICE_RECORDING_CALLBACK_URL=
TWILIO_VOICE_STATUS_CALLBACK_URL=

# Recording transcription and specialist voice-liveness/fraud adapters.
TRANSCRIPTION_PROVIDER_URL=
TRANSCRIPTION_PROVIDER_TOKEN=
TRANSCRIPTION_CALLBACK_URL=
VOICE_LIVENESS_PROVIDER_URL=
VOICE_LIVENESS_PROVIDER_TOKEN=

# Approved preference-aware keep-warm delivery adapter.
ENGAGEMENT_DELIVERY_WEBHOOK_URL=
ENGAGEMENT_DELIVERY_WEBHOOK_TOKEN=
